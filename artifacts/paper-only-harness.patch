@@ -0,0 +1,45 @@
+"""python -m paper_only [--self-check] [--state DIR]
+
+Does not connect a wallet. --self-check stays offline.
+The default run opens public read-only market feeds. It is not started
+by importing this module.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import sys
+from pathlib import Path
+
+from paper_only.lock import install_lock
+
+
+def main(argv: list[str] | None = None) -> int:
+    install_lock()
+    repo = Path(__file__).resolve().parents[1]
+    parser = argparse.ArgumentParser(
+        description="Isolated paper comparison. No wallet. No transaction sends.",
+    )
+    parser.add_argument(
+        "--self-check",
+        action="store_true",
+        help="Offline lock check. Does not open a feed.",
+    )
+    parser.add_argument(
+        "--state",
+        default="",
+        help="Dedicated state directory. Default: <repo>/paper_compare_state",
+    )
+    args = parser.parse_args(argv)
+    if args.self_check:
+        from paper_only.selfcheck import run_self_check
+        return run_self_check()
+    from paper_only.runner import launch
+    state = Path(args.state) if args.state else repo / "paper_compare_state"
+    asyncio.run(launch(state))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/paper_only/book.py b/paper_only/book.py
new file mode 100644
index 0000000..70f6730
--- /dev/null
+++ b/paper_only/book.py
@@ -0,0 +1,95 @@
+"""Side ledger that keeps freeze-hit, data-gap, and clean legs apart.
+
+RiskManager still writes its own logs. This file does not rewrite them.
+Bucket PnL is not a profit result. Legs that overlap a host freeze are
+not mixed into the clean bucket.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import time
+
+from paper_only.feedhealth import FeedHealth
+
+_BUCKETS = ("clean", "freeze_hit", "data_gap")
+
+
+class CompareBook:
+    def __init__(self, health: FeedHealth) -> None:
+        self.health = health
+        self._opens: dict[str, dict] = {}
+        self.counts = {name: {"n": 0, "risk_pnl_sol": 0.0, "cash_pnl_sol": 0.0} for name in _BUCKETS}
+
+    def on_open(self, mint: str, result: dict) -> None:
+        self._opens[mint] = {
+            "entry_wall": time.time(),
+            "notional": float(result.get("sol_spent") or 0.0),
+            "buy_fee": float(result.get("fee_sol") or 0.0),
+            "buy_priority": float(result.get("priority_sol") or 0.0),
+        }
+
+    def tag_record(self, record: dict) -> dict:
+        mint = record.get("mint", "")
+        meta = self._opens.get(mint) or {}
+        entry = float(record.get("entry_time") or meta.get("entry_wall") or time.time())
+        exit_t = float(record.get("exit_time") or time.time())
+        bucket = self.health.bucket(entry, exit_t)
+        notional = float(meta.get("notional") or 0.0)
+        invested = float(record.get("sol_invested") or 0.0)
+        fraction = (invested / notional) if notional > 0 else 1.0
+        buy_drag = (float(meta.get("buy_fee") or 0.0) + float(meta.get("buy_priority") or 0.0)) * fraction
+        risk_pnl = float(record.get("pnl_sol") or 0.0)
+        tagged = {
+            "mint": mint,
+            "symbol": record.get("symbol"),
+            "reason": record.get("reason"),
+            "partial": bool(record.get("partial")),
+            "entry_time": entry,
+            "exit_time": exit_t,
+            "sol_invested": invested,
+            "sol_received": record.get("sol_received"),
+            "risk_pnl_sol": risk_pnl,
+            "buy_cost_allocated_sol": buy_drag,
+            "cash_pnl_sol": risk_pnl - buy_drag,
+            "bucket": bucket,
+            "score": record.get("score"),
+        }
+        self.counts[bucket]["n"] += 1
+        self.counts[bucket]["risk_pnl_sol"] += risk_pnl
+        self.counts[bucket]["cash_pnl_sol"] += tagged["cash_pnl_sol"]
+        if not record.get("partial"):
+            self._opens.pop(mint, None)
+        self._append(tagged)
+        self.write_summary()
+        return tagged
+
+    def _append(self, tagged: dict) -> None:
+        os.makedirs("logs", exist_ok=True)
+        with open("logs/compare_trades.jsonl", "a", encoding="utf-8") as handle:
+            handle.write(json.dumps(tagged) + "\n")
+
+    def write_summary(self) -> None:
+        os.makedirs("logs", exist_ok=True)
+        payload = {
+            "note": (
+                "Buckets are mutually exclusive. Do not add them into a "
+                "profit claim. cash_pnl_sol subtracts the buy-side 1% fee "
+                "and 0.0005 SOL priority from the risk manager's pnl, which "
+                "does not include those entry debits."
+            ),
+            "buckets": self.counts,
+            "open_positions": len(self._opens),
+        }
+        tmp = "logs/compare_buckets.json.tmp"
+        with open(tmp, "w", encoding="utf-8") as handle:
+            json.dump(payload, handle, indent=2)
+        os.replace(tmp, "logs/compare_buckets.json")
+
+    def write_health(self) -> None:
+        os.makedirs("logs", exist_ok=True)
+        tmp = "logs/feed_health.json.tmp"
+        with open(tmp, "w", encoding="utf-8") as handle:
+            json.dump(self.health.snapshot(), handle, indent=2)
+        os.replace(tmp, "logs/feed_health.json")
diff --git a/paper_only/costs.py b/paper_only/costs.py
new file mode 100644
index 0000000..d1d81da
--- /dev/null
+++ b/paper_only/costs.py
@@ -0,0 +1,69 @@
+"""Independent paper fills for the comparison book.
+
+These are not trader.paper_executor. Upstream's realistic sim uses
+size-dependent slippage, an MEV tax, a 5% fail lottery, and priority fees
+of up to 0.001 SOL on buys and 0.005 SOL on sells.
+
+This module uses the comparison cost assumptions:
+
+- fixed notional 0.1 SOL (the curve exposure, not a compounded balance)
+- 1% fee per side
+- 2% adverse slippage per side
+- 0.0005 SOL priority fee per transaction
+
+Buy cash leaving the wallet is notional + fee + priority. The fee and
+priority are extra debits, not taken out of the 0.1. Sell cash received is
+gross after adverse slippage, minus the 1% fee, minus 0.0005 SOL.
+"""
+
+from __future__ import annotations
+
+FIXED_ENTRY_SOL = 0.1
+FEE_RATE = 0.01
+ADVERSE_SLIPPAGE = 0.02
+PRIORITY_FEE_SOL = 0.0005
+
+
+def buy_fill(mid_price_sol_per_raw: float, notional: float = FIXED_ENTRY_SOL) -> dict:
+    """Simulate a buy at a worse price than mid. mid is SOL per raw token unit."""
+    if mid_price_sol_per_raw <= 0:
+        raise ValueError("mid price must be positive")
+    if notional <= 0:
+        raise ValueError("notional must be positive")
+    effective = mid_price_sol_per_raw * (1.0 + ADVERSE_SLIPPAGE)
+    tokens = int(notional / effective)
+    fee = notional * FEE_RATE
+    priority = PRIORITY_FEE_SOL
+    return {
+        "notional_sol": notional,
+        "mid_price": mid_price_sol_per_raw,
+        "effective_price": effective,
+        "tokens": tokens,
+        "fee_sol": fee,
+        "priority_sol": priority,
+        "cash_debit": notional + fee + priority,
+        "slippage": ADVERSE_SLIPPAGE,
+    }
+
+
+def sell_fill(tokens: int, mid_price_sol_per_raw: float) -> dict:
+    """Simulate a sell at a worse price than mid."""
+    if tokens <= 0:
+        raise ValueError("tokens must be positive")
+    if mid_price_sol_per_raw <= 0:
+        raise ValueError("mid price must be positive")
+    gross = tokens * mid_price_sol_per_raw * (1.0 - ADVERSE_SLIPPAGE)
+    fee = gross * FEE_RATE
+    priority = PRIORITY_FEE_SOL
+    received = gross - fee - priority
+    if received < 0:
+        received = 0.0
+    return {
+        "tokens": tokens,
+        "mid_price": mid_price_sol_per_raw,
+        "gross_sol": gross,
+        "fee_sol": fee,
+        "priority_sol": priority,
+        "sol_received": received,
+        "slippage": ADVERSE_SLIPPAGE,
+    }
diff --git a/paper_only/executor.py b/paper_only/executor.py
new file mode 100644
index 0000000..20e4066
--- /dev/null
+++ b/paper_only/executor.py
@@ -0,0 +1,168 @@
+"""Paper executor with no signing surface.
+
+Fills come from paper_only.costs. Prices are marks supplied by the caller.
+Nothing in this class imports solders, builds a transaction, or talks to a
+trader endpoint.
+"""
+
+from __future__ import annotations
+
+import time
+
+from paper_only.costs import FIXED_ENTRY_SOL, buy_fill, sell_fill
+
+
+def mid_from_launch(token: dict | None) -> float:
+    """SOL per raw token unit, same conversion as trader.paper_executor.buy.
+
+    PumpPortal's vTokensInBondingCurve is treated as UI tokens and pump.fun
+    tokens use 6 decimals. Returns 0 when the launch payload has no reserves.
+    """
+    if not token:
+        return 0.0
+    v_sol = float(token.get("v_sol_in_bonding") or 0)
+    v_tokens = float(token.get("v_tokens_in_bonding") or 0)
+    if v_sol <= 0 or v_tokens <= 0:
+        return 0.0
+    return v_sol / (v_tokens * 1_000_000)
+
+
+class ComparisonPaperExecutor:
+    def __init__(self, wallet) -> None:
+        self.wallet = wallet
+        self._prices: dict[str, float] = {}
+        self._held: dict[str, int] = {}
+
+    async def start(self) -> None:
+        return None
+
+    async def stop(self) -> None:
+        return None
+
+    def update_price(self, mint: str, price_per_raw: float) -> None:
+        if price_per_raw and price_per_raw > 0:
+            self._prices[mint] = float(price_per_raw)
+
+    async def prebuild_sell_tx(self, token_mint: str):
+        """Compat shim. There is no transaction to prebuild."""
+        return None
+
+    def _resolve_tokens(self, mint: str, raw) -> int:
+        held = self._held.get(mint, 0)
+        if isinstance(raw, str):
+            text = raw.strip()
+            if text.endswith("%"):
+                try:
+                    pct = float(text[:-1])
+                except ValueError:
+                    return 0
+                return max(0, int(held * (pct / 100.0)))
+            try:
+                return max(0, int(float(text)))
+            except ValueError:
+                return 0
+        try:
+            return max(0, int(raw))
+        except (TypeError, ValueError):
+            return 0
+
+    async def buy(self, token_mint: str, sol_amount: float, token: dict | None = None) -> dict:
+        now = time.time()
+        if abs(float(sol_amount) - FIXED_ENTRY_SOL) > 1e-9:
+            return {
+                "success": False,
+                "error": "non_fixed_size",
+                "venue": "paper",
+                "type": "buy",
+                "mint": token_mint,
+                "timestamp": now,
+            }
+        mid = mid_from_launch(token) or self._prices.get(token_mint, 0.0)
+        if mid <= 0:
+            return {
+                "success": False,
+                "error": "no_price",
+                "venue": "paper",
+                "type": "buy",
+                "mint": token_mint,
+                "timestamp": now,
+            }
+        fill = buy_fill(mid, FIXED_ENTRY_SOL)
+        if fill["tokens"] <= 0:
+            return {
+                "success": False,
+                "error": "zero_fill",
+                "venue": "paper",
+                "type": "buy",
+                "mint": token_mint,
+                "timestamp": now,
+            }
+        balance = await self.wallet.get_sol_balance()
+        if balance < fill["cash_debit"]:
+            return {
+                "success": False,
+                "error": "insufficient_paper_balance",
+                "venue": "paper",
+                "type": "buy",
+                "mint": token_mint,
+                "timestamp": now,
+            }
+        self.wallet.deduct(fill["cash_debit"])
+        self._held[token_mint] = self._held.get(token_mint, 0) + fill["tokens"]
+        self._prices[token_mint] = mid
+        return {
+            "success": True,
+            "signature": f"PAPER_{token_mint[:8]}_{int(now)}",
+            "type": "buy",
+            "mint": token_mint,
+            "sol_spent": FIXED_ENTRY_SOL,
+            "tokens_expected": fill["tokens"],
+            "fee_sol": fill["fee_sol"],
+            "priority_sol": fill["priority_sol"],
+            "cash_debit": fill["cash_debit"],
+            "venue": "paper",
+            "timestamp": now,
+        }
+
+    async def sell(
+        self,
+        token_mint: str,
+        token_amount,
+        reason: str = "exit",
+        prebuilt_tx: bytes | None = None,
+        price_history: list | None = None,
+    ) -> dict:
+        del prebuilt_tx, price_history
+        now = time.time()
+        amount = self._resolve_tokens(token_mint, token_amount)
+        mid = self._prices.get(token_mint, 0.0)
+        if amount <= 0 or mid <= 0:
+            return {
+                "success": False,
+                "error": "no_price" if mid <= 0 else "zero_amount",
+                "venue": "paper",
+                "type": "sell",
+                "mint": token_mint,
+                "reason": reason,
+                "timestamp": now,
+            }
+        fill = sell_fill(amount, mid)
+        remaining = self._held.get(token_mint, 0) - amount
+        if remaining > 0:
+            self._held[token_mint] = remaining
+        else:
+            self._held.pop(token_mint, None)
+        self.wallet.credit(fill["sol_received"])
+        return {
+            "success": True,
+            "signature": f"PAPER_SELL_{token_mint[:8]}_{int(now)}",
+            "type": "sell",
+            "mint": token_mint,
+            "reason": reason,
+            "sol_received": fill["sol_received"],
+            "fee_sol": fill["fee_sol"],
+            "priority_sol": fill["priority_sol"],
+            "tokens_sold": amount,
+            "venue": "paper",
+            "timestamp": now,
+        }
diff --git a/paper_only/feedhealth.py b/paper_only/feedhealth.py
new file mode 100644
index 0000000..cdbf825
--- /dev/null
+++ b/paper_only/feedhealth.py
@@ -0,0 +1,116 @@
+"""Host-freeze and market-data-gap tracker.
+
+Host freeze: the event-loop heartbeat woke up late. A stall of at least
+FREEZE_DETECT_S is recorded, new entries pause for ENTRY_PAUSE_S, and a
+stall of at least FLATTEN_FREEZE_S requests a flatten.
+
+Data gap: silence on the PumpPortal stream of at least WS_GAP_S. Gaps are
+counted separately from freezes. A quiet market can look like a gap; the
+stat is a feed-health record, not proof of a missed edge.
+"""
+
+from __future__ import annotations
+
+import time
+
+HEARTBEAT_INTERVAL_S = 1.0
+FREEZE_DETECT_S = 5.0
+ENTRY_PAUSE_S = 90.0
+FLATTEN_FREEZE_S = 300.0
+WS_GAP_S = 15.0
+
+
+class FeedHealth:
+    def __init__(self) -> None:
+        now = time.monotonic()
+        self._last_beat = now
+        self._last_ws = now
+        self._ws_armed = False
+        self._seq = 0
+        self.entry_pause_until = 0.0
+        self.pending_flatten = False
+        self.freezes: list[dict] = []
+        self.gaps: list[dict] = []
+
+    def observe_stall(self, stall_s: float, *, wall_end: float | None = None) -> dict | None:
+        if stall_s < FREEZE_DETECT_S:
+            return None
+        self._seq += 1
+        end = time.time() if wall_end is None else wall_end
+        rec = {
+            "id": self._seq,
+            "kind": "host_freeze",
+            "stall_s": round(float(stall_s), 3),
+            "wall_start": end - float(stall_s),
+            "wall_end": end,
+            "flatten": float(stall_s) >= FLATTEN_FREEZE_S,
+        }
+        self.freezes.append(rec)
+        self.entry_pause_until = time.monotonic() + ENTRY_PAUSE_S
+        if rec["flatten"]:
+            self.pending_flatten = True
+        return rec
+
+    def heartbeat(self) -> dict | None:
+        now = time.monotonic()
+        elapsed = now - self._last_beat
+        self._last_beat = now
+        return self.observe_stall(elapsed - HEARTBEAT_INTERVAL_S)
+
+    def note_ws_message(self) -> dict | None:
+        now = time.monotonic()
+        if not self._ws_armed:
+            self._ws_armed = True
+            self._last_ws = now
+            return None
+        gap = now - self._last_ws
+        self._last_ws = now
+        if gap < WS_GAP_S:
+            return None
+        self._seq += 1
+        end = time.time()
+        rec = {
+            "id": self._seq,
+            "kind": "data_gap",
+            "gap_s": round(gap, 3),
+            "wall_start": end - gap,
+            "wall_end": end,
+        }
+        self.gaps.append(rec)
+        return rec
+
+    def entries_paused(self) -> bool:
+        return time.monotonic() < self.entry_pause_until
+
+    def consume_flatten(self) -> bool:
+        if not self.pending_flatten:
+            return False
+        self.pending_flatten = False
+        return True
+
+    @staticmethod
+    def _overlaps(events: list[dict], start_wall: float, end_wall: float) -> bool:
+        for ev in events:
+            if ev["wall_start"] <= end_wall and ev["wall_end"] >= start_wall:
+                return True
+        return False
+
+    def bucket(self, start_wall: float, end_wall: float) -> str:
+        """Mutually exclusive label. A freeze hides a gap on the same hold."""
+        if self._overlaps(self.freezes, start_wall, end_wall):
+            return "freeze_hit"
+        if self._overlaps(self.gaps, start_wall, end_wall):
+            return "data_gap"
+        return "clean"
+
+    def snapshot(self) -> dict:
+        return {
+            "freezes": list(self.freezes),
+            "gaps": list(self.gaps),
+            "entries_paused": self.entries_paused(),
+            "pending_flatten": self.pending_flatten,
+            "freeze_detect_s": FREEZE_DETECT_S,
+            "entry_pause_s": ENTRY_PAUSE_S,
+            "flatten_freeze_s": FLATTEN_FREEZE_S,
+            "ws_gap_s": WS_GAP_S,
+        }
